"duration": 41.536,
"fps": 30,
"lines": [
{
"spk": "A",
"text": "Pak Darman! Mulai hari ini Asep teh hidup sehat. Udah punya personal trainer!",
"start": 0.6,
"end": 4.917
},
{
"spk": "D",
"text": "Trainer? Kamu punya kereta pribadi, Sep?",
"start": 5.117,
"end": 7.724
},
{
"spk": "A",
"text": "Bukan kereta, Pak! Pelatih! Galak, disiplin, tiap subuh nungguin depan rumah.",
"start": 7.924,
"end": 14.065
},
{
"spk": "D",
"text": "Wah, mahal itu. Bayarnya berapa?",
"start": 14.265,
"end": 17.049
},
{
"spk": "A",
"text": "Gratis, Pak. Cuma dikasih tulang.",
"start": 17.199,
"end": 19.331
},
{
"spk": "D",
"text": "Tulang?",
"start": 19.631,
"end": 20.11
},
{
"spk": "A",
"text": "Hari pertama lari lima kilo! Hari kedua lima kilo lagi!",
"start": 20.36,
"end": 23.273
},
{
"spk": "D",
"text": "Hebat! Hari ketiga?",
"start": 23.473,
"end": 26.387
},
{
"spk": "A",
"text": "Hari ketiga pelatihnya dibawa mudik. Asep juga libur.",
"start": 26.587,
"end": 29.712
},
{
"spk": "D",
"text": "Pelatih kok dibawa mudik? Emang pelatihnya siapa?",
"start": 29.962,
"end": 34.481
},
{
"spk": "A",
"text": "Si Bleki, Pak.",
"start": 34.981,
"end": 36.6
},
{
"spk": "D",
"text": "Sep! Tolong! Kereta pribadinya ngejar Bapak!",
"start": 37.6,
"end": 40.336
}
],
