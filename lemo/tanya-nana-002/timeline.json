"cues": [
{
"who": "nana",
"t0": 0.4,
"t1": 2.25,
"text": "Kak, kenapa sih kalau sholat"
},
{
"who": "nana",
"t0": 2.3,
"t1": 4.1,
"text": "kita harus menghadap kiblat?"
},
{
"who": "kakak",
"t0": 5.2,
"t1": 7.15,
"text": "Kiblat itu arah ke Ka'bah,"
},
{
"who": "kakak",
"t0": 7.3,
"t1": 9.05,
"text": "di kota Makkah."
},
{
"who": "kakak",
"t0": 9.1,
"t1": 10.75,
"text": "Allah memerintahkan kita"
},
{
"who": "kakak",
"t0": 10.8,
"t1": 13.35,
"text": "menghadap ke sana setiap kali sholat."
},
{
"who": "kakak",
"t0": 14.0,
"t1": 17.15,
"text": "Dari Indonesia, Ka'bah jauh sekali."
},
{
"who": "kakak",
"t0": 17.7,
"t1": 21.35,
"text": "Hampir 8.000 km, ke arah barat laut."
},
{
"who": "kakak",
"t0": 22.4,
"t1": 24.05,
"text": "Tahukah kamu?"
},
{
"who": "kakak",
"t0": 24.1,
"t1": 25.85,
"text": "Saat sholat, umat Islam"
},
{
"who": "kakak",
"t0": 25.9,
"t1": 27.25,
"text": "di seluruh dunia menghadap"
},
{
"who": "kakak",
"t0": 27.3,
"t1": 30.15,
"text": "ke satu titik yang sama: Ka'bah."
},
{
"who": "nana",
"t0": 30.5,
"t1": 32.95,
"text": "Wah, jadi kita semua kompak, ya, Kak!"
},
{
"who": "kakak",
"t0": 33.5,
"t1": 34.75,
"text": "Misi hari ini:"
},
{
"who": "kakak",
"t0": 34.8,
"t1": 37.75,
"text": "cari tahu arah kiblat di rumahmu, ya!"
},
{
"who": "kakak",
"t0": 38.2,
"t1": 39.55,
"text": "Besok kita cari tahu,"
},
{
"who": "kakak",
"t0": 39.6,
"t1": 42.15,
"text": "kenapa baca bismillah sebelum makan?"
}
],
