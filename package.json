{
  "name": "video-3d-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Template video animasi 3D (Three.js) + caption + audio, dirender pakai Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Video3D out/video.mp4",
    "render:ep12": "remotion render Episode12 out/episode12.mp4 --crf=26",
    "render:doa": "remotion render DoaPanggung out/doa-panggung.mp4 --crf=26",
    "render:doa-laki": "remotion render DoaPanggungLaki out/doa-panggung-laki.mp4 --crf=26",
    "still": "remotion still Video3D out/thumbnail.png --frame=60",
    "render:iklan-huruf": "remotion render src/iklan/index.ts IklanHuruf out/iklan-huruf.mp4 --crf=23",
    "render:tutorial-print": "remotion render src/tutorial/index.ts TutorialPrint out/tutorial-print.mp4 --crf=23",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "@remotion/three": "4.0.541",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.541",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
